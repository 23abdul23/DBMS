generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  student
  warden
  security
  admin
}

enum Gender {
  male
  female
  other
}

enum Department {
  IT
  IT_BI
  Electronics
}

enum AcademicYear {
  FIRST_YEAR
  SECOND_YEAR
  THIRD_YEAR
  FOURTH_YEAR
}

enum EmergencyType {
  medical
  security
  fire
  other
}

enum EmergencyStatus {
  active
  responded
  resolved
}

enum EmergencyPriority {
  low
  medium
  high
  critical
}

enum MediaType {
  photo
  audio
}

enum OutpassStatus {
  pending
  approved
  rejected
  expired
  cancelled
}

enum OutpassRequestType {
  regular
  long_visit
}

enum LogAction {
  entry
  exit
  scan_attempt
  without_outpass
  outpass_request
  outpass_generated
  outpass_used
  outpass_long_visit
  outpass_status_changed
  emergency_status_updated
  user_status_updated
  emergency_alert
  sac_room_opened
  sac_room_joined
  sac_room_left
  sac_equipment_taken
  sac_equipment_returned
  library_seat_taken
  library_seat_released
}

enum ScanType {
  qr
  nfc
  manual
}

model User {
  id               String    @id @db.VarChar(24)
  name             String
  email            String    @unique @db.VarChar(255)
  passwordHash     String    @map("password_hash") @db.VarChar(255)
  role             UserRole  @default(student)
  gender           Gender?
  // Legacy role-specific columns are retained temporarily for compatibility during migration.
  department       Department?
  year             AcademicYear?
  hostel           String?   @db.VarChar(255)
  roomNumber       String?   @map("room_number") @db.VarChar(50)
  phoneNumber      String?   @map("phone_number") @db.VarChar(20)
  emergencyContact String?   @map("emergency_contact") @db.VarChar(255)
  profilePhoto     String?   @map("profile_photo") @db.VarChar(500)
  studentId        String?   @unique @map("student_id") @db.VarChar(100)
  guardId          String?   @unique @map("guard_id") @db.VarChar(100)
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  studentProfile         StudentProfile?
  wardenProfile          WardenProfile?
  securityProfile        SecurityProfile?
  
  emergencies            Emergency[] @relation("EmergencyOwner")
  respondedEmergencies   Emergency[] @relation("EmergencyResponder")
  outpasses              Outpass[]   @relation("OutpassOwner")
  approvedOutpasses      Outpass[]   @relation("OutpassApprover")
  outpassAuditChanges    OutpassAuditTrail[]
  passwordUpdateOtps     PasswordUpdateOtp[]
  logs                   Log[]
  sacRoomSessionsOpened  SacRoomSession[]       @relation("SacRoomOpenedBy")
  sacRoomPresences       SacRoomPresence[]      @relation("SacRoomPresenceUser")
  sacEquipmentCheckouts  SacEquipmentCheckout[] @relation("SacEquipmentCheckoutUser")
  librarySeatSessions    LibrarySeatSession[]   @relation("LibrarySeatSessionUser")

  @@index([role])
  @@index([hostel])
  @@map("users")
}

model SacRoomSession {
  id             String            @id @db.VarChar(24)
  roomName       String            @map("room_name") @db.VarChar(100)
  openedByUserId String            @map("opened_by_user_id") @db.VarChar(24)
  openedAt       DateTime          @default(now()) @map("opened_at")
  closedAt       DateTime?         @map("closed_at")
  lastActivityAt DateTime          @default(now()) @map("last_activity_at")

  openedBy  User              @relation("SacRoomOpenedBy", fields: [openedByUserId], references: [id], onDelete: Cascade)
  presences SacRoomPresence[]

  @@index([roomName, closedAt])
  @@index([openedAt(sort: Desc)])
  @@index([lastActivityAt(sort: Desc)])
  @@map("sac_room_sessions")
}

model SacRoomPresence {
  id        String   @id @db.VarChar(24)
  sessionId String   @map("session_id") @db.VarChar(24)
  userId    String   @map("user_id") @db.VarChar(24)
  joinedAt  DateTime @default(now()) @map("joined_at")
  leftAt    DateTime? @map("left_at")

  session SacRoomSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User           @relation("SacRoomPresenceUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId, leftAt])
  @@index([userId, leftAt])
  @@index([joinedAt(sort: Desc)])
  @@map("sac_room_presences")
}

model SacEquipmentCheckout {
  id            String    @id @db.VarChar(24)
  equipmentName String    @map("equipment_name") @db.VarChar(100)
  userId        String    @map("user_id") @db.VarChar(24)
  checkedOutAt  DateTime  @default(now()) @map("checked_out_at")
  returnedAt    DateTime? @map("returned_at")

  user User @relation("SacEquipmentCheckoutUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([equipmentName, returnedAt])
  @@index([userId, returnedAt])
  @@index([checkedOutAt(sort: Desc)])
  @@map("sac_equipment_checkouts")
}

model LibrarySeatSession {
  id             String    @id @db.VarChar(24)
  userId         String    @map("user_id") @db.VarChar(24)
  seatNumber     Int       @map("seat_number")
  enteredAt      DateTime  @default(now()) @map("entered_at")
  leftAt         DateTime? @map("left_at")
  lastActivityAt DateTime  @default(now()) @map("last_activity_at")

  user User @relation("LibrarySeatSessionUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, leftAt])
  @@index([seatNumber, leftAt])
  @@index([enteredAt(sort: Desc)])
  @@index([lastActivityAt(sort: Desc)])
  @@map("library_seat_sessions")
}

model StudentProfile {
  userId      String       @id @map("user_id") @db.VarChar(24)
  studentId   String       @unique @map("student_id") @db.VarChar(100)
  department  Department
  year        AcademicYear
  hostel      String       @db.VarChar(255)
  roomNumber  String?      @map("room_number") @db.VarChar(50)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([hostel])
  @@map("student_profiles")
}

model WardenProfile {
  userId     String   @id @map("user_id") @db.VarChar(24)
  hostel     String   @unique @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("warden_profiles")
}

model SecurityProfile {
  userId        String   @id @map("user_id") @db.VarChar(24)
  guardId       String   @unique @map("guard_id") @db.VarChar(100)
  securityPost  String   @map("security_post") @db.VarChar(255)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([securityPost])
  @@map("security_profiles")
}

model Emergency {
  id             String            @id @db.VarChar(24)
  userId         String            @map("user_id") @db.VarChar(24)
  type           EmergencyType
  description    String?
  latitude       Decimal           @db.Decimal(9, 6)
  longitude      Decimal           @db.Decimal(9, 6)
  address        String?           @db.VarChar(500)
  status         EmergencyStatus   @default(active)
  respondedById  String?           @map("responded_by") @db.VarChar(24)
  responseTime   DateTime?         @map("response_time")
  resolvedTime   DateTime?         @map("resolved_time")
  priority       EmergencyPriority @default(medium)
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  user           User               @relation("EmergencyOwner", fields: [userId], references: [id], onDelete: Cascade)
  respondedBy    User?              @relation("EmergencyResponder", fields: [respondedById], references: [id], onDelete: SetNull)
  media          EmergencyMedia[]
  contactCalls   EmergencyContactCall[]

  @@index([status, priority])
  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@map("emergencies")
}

model EmergencyMedia {
  id          String    @id @db.VarChar(24)
  emergencyId String    @map("emergency_id") @db.VarChar(24)
  url         String    @db.VarChar(500)
  mediaType   MediaType @map("media_type")
  uploadedAt  DateTime? @map("uploaded_at")

  emergency Emergency @relation(fields: [emergencyId], references: [id], onDelete: Cascade)

  @@index([emergencyId])
  @@map("emergency_media")
}

model EmergencyContactCall {
  id          String    @id @db.VarChar(24)
  emergencyId String    @map("emergency_id") @db.VarChar(24)
  name        String?   @db.VarChar(255)
  phone       String?   @db.VarChar(20)
  calledAt    DateTime? @map("called_at")

  emergency Emergency @relation(fields: [emergencyId], references: [id], onDelete: Cascade)

  @@index([emergencyId])
  @@map("emergency_contact_calls")
}

model Outpass {
  id                    String       @id @db.VarChar(24)
  userId                String       @map("user_id") @db.VarChar(24)
  reason                String       @db.VarChar(500)
  destination           String       @db.VarChar(500)
  outDate               DateTime     @map("out_date")
  expectedReturnDate    DateTime     @map("expected_return_date")
  actualReturnDate      DateTime?    @map("actual_return_date")
  requestType           OutpassRequestType @default(regular) @map("request_type")
  status                OutpassStatus @default(pending)
  approvedById          String?      @map("approved_by") @db.VarChar(25)
  rejectionReason       String?      @map("rejection_reason")
  emergencyContactName  String?      @map("emergency_contact_name") @db.VarChar(255)
  emergencyContactPhone String?      @map("emergency_contact_phone") @db.VarChar(20)
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")

  user        User               @relation("OutpassOwner", fields: [userId], references: [id], onDelete: Cascade)
  approvedBy  User?              @relation("OutpassApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  auditTrail  OutpassAuditTrail[]

  @@index([userId, status])
  @@index([userId, requestType, status])
  @@index([outDate])
  @@map("outpasses")
}

model OutpassAuditTrail {
  id        String   @id @db.VarChar(24)
  outpassId String   @map("outpass_id") @db.VarChar(24)
  status    String   @db.VarChar(50)
  changedBy String?  @map("changed_by") @db.VarChar(24)
  changedAt DateTime @map("changed_at")
  remarks   String?

  outpass Outpass @relation(fields: [outpassId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [changedBy], references: [id], onDelete: SetNull)

  @@index([outpassId])
  @@map("outpass_audit_trail")
}

model PasswordUpdateOtp {
  id                  String   @id @db.VarChar(24)
  userId              String   @map("user_id") @db.VarChar(24)
  otpHash             String   @map("otp_hash") @db.VarChar(255)
  pendingPasswordHash String   @map("pending_password_hash") @db.VarChar(255)
  expiresAt           DateTime @map("expires_at")
  createdAt           DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@map("password_update_otps")
}

model Location {
  id          String   @id @db.VarChar(24)
  name        String   @unique @db.VarChar(255)
  code        String   @unique @db.VarChar(100)
  hash        String   @unique @db.VarChar(256)
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("locations")
}

model Log {
  id          String    @id @db.VarChar(24)
  userId      String    @map("user_id") @db.VarChar(24)
  action      LogAction
  location    String?   @db.VarChar(255)
  guardId     String?   @map("guard_id") @db.VarChar(100)
  guardName   String?   @map("guard_name") @db.VarChar(255)
  deviceInfo  String?   @map("device_info") @db.VarChar(500)
  ipAddress   String?   @map("ip_address") @db.VarChar(45)
  success     Boolean   @default(true)
  details     Json?
  errorCode   String?   @map("error_code") @db.VarChar(100)
  errorMessage String?  @map("error_message")
  scanType    ScanType  @default(qr) @map("scan_type")
  createdAt   DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([location, createdAt(sort: Desc)])
  @@map("logs")
}

